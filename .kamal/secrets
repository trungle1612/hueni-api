# Secrets for config/deploy.yml. Never put raw credentials here: this file is in git.
# In GitHub Actions both come from repository secrets; locally RAILS_MASTER_KEY falls back to config/master.key
# and KAMAL_REGISTRY_PASSWORD must be a GitHub token with write:packages.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=${RAILS_MASTER_KEY:-$(cat config/master.key)}

# Secrets for config/deploy.yml. Never put raw credentials here: this file is in git.
# Dotenv syntax: plain $VAR / $(command) only, no ${VAR:-default}.
# GitHub Actions sets these from repository secrets; locally load them from .env first (set -a; source .env; set +a).
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$RAILS_MASTER_KEY
ZALO_APP_ID=$ZALO_APP_ID
ZALO_APP_SECRET=$ZALO_APP_SECRET

# Litestream → Cloudflare R2 (token scoped to the hueni-api-backup bucket; endpoint https://<account-id>.r2.cloudflarestorage.com).
LITESTREAM_ACCESS_KEY_ID=$LITESTREAM_ACCESS_KEY_ID
LITESTREAM_SECRET_ACCESS_KEY=$LITESTREAM_SECRET_ACCESS_KEY
LITESTREAM_R2_ENDPOINT=$LITESTREAM_R2_ENDPOINT

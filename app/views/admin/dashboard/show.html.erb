<% content_for :title, "Tổng quan · hueni admin" %>

<h1 class="text-xl font-semibold mb-4">Tổng quan</h1>

<% if @places.any? %>
  <div class="flex flex-col gap-3">
    <% @places.each do |place| %>
      <%= link_to admin_place_path(place.slug), class: "card bg-base-100 shadow-sm hover:shadow-md transition-shadow" do %>
        <div class="card-body p-4 gap-1">
          <div class="font-semibold"><%= place.name %></div>
          <% if place.address.present? %>
            <div class="text-sm opacity-60" data-address><%= place.address %></div>
          <% end %>
          <div class="flex flex-wrap gap-2 mt-1">
            <%= place_role_badge(place) %>
            <%= vacancy_badge(@vacancy.dig(place.slug, :left), @active_rooms[place.id]) %>
            <% if (errors = @feed_errors[place.id].to_i).positive? %>
              <span class="badge badge-soft badge-error">Lỗi đồng bộ (<%= errors %>)</span>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="card bg-base-100 border border-dashed border-base-300">
    <div class="card-body items-center text-center py-10">
      <%= render "shared/icon", name: "home" %>
      <div class="font-semibold">Chưa có homestay nào</div>
      <div class="text-sm opacity-70">Quản trị viên sẽ gán homestay cho tài khoản của bạn.</div>
    </div>
  </div>
<% end %>

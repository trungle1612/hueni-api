<% content_for :title, "Tổng quan · hueni admin" %>

<h1 class="text-xl font-semibold mb-4">Tổng quan</h1>

<%# Admins link from their own page in Người dùng. %>
<%= render "shared/link_zalo" unless Current.user.zalo_id || Current.user.admin? %>
<% if @pending_registrations.to_i.positive? %>
  <%= link_to admin_users_path(anchor: "registrations"), id: "pending_registrations", class: "alert alert-info alert-soft mb-4" do %>
    <span><%= @pending_registrations %> yêu cầu đăng ký chờ duyệt</span>
  <% end %>
<% end %>

<% if @places.any? %>
  <nav id="day" class="tabs tabs-box mb-3" aria-label="Ngày">
    <%= link_to "Hôm nay", admin_root_path, class: "tab flex-1 #{"tab-active" unless @tomorrow}" %>
    <%= link_to "Ngày mai", admin_root_path(day: "mai"), class: "tab flex-1 #{"tab-active" if @tomorrow}" %>
  </nav>
  <div id="stats" class="grid grid-cols-4 gap-2 mb-4">
    <% { arrivals: [ "Chờ đến", @arrivals.size ], departures: [ "Chờ đi", @departures.size ], in_house: [ "Đang ở", @in_house.size, "/#{@open_rooms}" ],
         dirty_rooms: [ @tomorrow ? "Sẽ cần dọn" : "Cần dọn", @dirty_rooms.size ] }.each do |key, (label, count, of)| %>
      <div id="stat_<%= key %>" class="bg-base-100 rounded-box shadow-sm py-2 text-center <%= "text-base-content/60" if count.zero? %>">
        <div class="text-xl font-bold leading-tight"><%= count %><% if of %><span class="text-sm font-normal opacity-70"><%= of %></span><% end %></div>
        <div class="text-sm opacity-80"><%= label %></div>
      </div>
    <% end %>
  </div>

  <% if @issues.any? %>
    <% issue = ->(kind, title, detail, path) { link_to(path, class: "flex items-center gap-3 py-2") { safe_join([ activity_icon(kind, size: "size-7"), tag.span(safe_join([ tag.span(title, class: "font-semibold"), tag.span(detail, class: "block text-sm opacity-80") ]), class: "min-w-0") ]) } } %>
    <section id="issues" class="card bg-base-100 shadow-sm mb-4">
      <div class="card-body p-4 gap-1">
        <h2 class="font-semibold">Cần xử lý · <%= @issues.size %></h2>
        <div class="divide-y divide-base-200">
          <% @issues.first(3).each do |args| %><%= issue.(*args) %><% end %>
        </div>
        <% if @issues.size > 3 %>
          <details>
            <summary class="link link-primary text-sm py-1">Xem thêm <%= @issues.size - 3 %></summary>
            <div class="divide-y divide-base-200"><% @issues.drop(3).each do |args| %><%= issue.(*args) %><% end %></div>
          </details>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>

<% if [ @departures, @dirty_rooms, @arrivals, @in_house ].any?(&:present?) %>
  <%= render "today" %>
<% elsif @tomorrow %>
  <p id="today" class="text-center opacity-70 mb-6">Ngày mai chưa có khách đến hay đi.</p>
<% end %>

<% if @places.any? %>
  <div class="flex flex-col gap-3">
    <% @places.each do |place| %>
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body p-4 gap-3">
          <div class="flex flex-wrap items-center gap-2">
            <%= link_to place.name, admin_place_path(place.slug), class: "font-semibold mr-auto" %>
            <%= place_role_badge(place) if @places.size > 1 %>
            <%= vacancy_badge(@vacancy.dig(place.slug, :left), @active_rooms[place.id]) %>
            <% if (errors = @feed_errors[place.id].to_i).positive? %>
              <%= link_to "Lỗi đồng bộ (#{errors})", admin_calendar_feeds_path, class: "badge badge-soft badge-error" %>
            <% end %>
          </div>
          <% if (days = @days_by_place[place.id]).present? %>
            <div class="grid grid-cols-2 gap-2">
              <% days.each do |day| %>
                <%= link_to admin_place_path(place.slug, anchor: dom_id(day.room)), id: dom_id(day.room, :tile),
                      class: "rounded-box p-3 min-w-0 #{room_tile_class(day)} #{"opacity-60" unless day.room.active?}" do %>
                  <div class="font-semibold truncate"><%= day.room.name %></div>
                  <div class="text-sm font-semibold opacity-80"><%= room_state_label(day) %></div>
                  <% if day.booking %>
                    <div class="text-sm opacity-80 truncate"><%= booking_label(day.booking) %> · trả <%= day.booking.end_date.strftime("%d/%m") %></div>
                  <% elsif day.next_booking %>
                    <div class="text-sm opacity-80 truncate">Khách tới: <%= day.next_booking.start_date.strftime("%d/%m") %></div>
                  <% end %>
                  <% if day.room.dirty? %><span class="badge badge-soft badge-warning badge-sm mt-1">Chưa dọn</span><% end %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% elsif !@all_places %>
  <div class="card bg-base-100 border border-dashed border-base-300">
    <div class="card-body items-center text-center py-10">
      <%= render "shared/icon", name: "home" %>
      <div class="font-semibold">Chưa có homestay nào</div>
      <div class="text-sm opacity-70">Quản trị viên sẽ gán homestay cho tài khoản của bạn.</div>
    </div>
  </div>
<% end %>

<% if @all_places %>
  <section class="mt-6">
    <h2 class="font-semibold">Homestay</h2>
    <p class="text-xs opacity-60 mb-2">Dữ liệu homestay chỉ thành viên xem được. Muốn giúp chủ nhà: thêm mình làm thành viên ở <%= link_to "Người dùng", admin_users_path, class: "link" %>.</p>
    <ul id="all_places" class="bg-base-100 rounded-box shadow-sm divide-y divide-base-200">
      <% @all_places.each do |place| %>
        <li class="p-3 text-sm">
          <div class="flex flex-wrap items-center gap-2">
            <% if Current.user.role_at(place) %>
              <%= link_to place.name, admin_place_path(place.slug), class: "font-semibold mr-auto" %>
            <% else %>
              <span class="font-semibold mr-auto"><%= place.name %></span>
            <% end %>
            <% if (errors = @all_feed_errors[place.id].to_i).positive? %>
              <span class="badge badge-soft badge-error badge-sm">Kênh OTA lỗi: <%= errors %></span>
            <% end %>
          </div>
          <div class="text-xs opacity-70">
            <% members = place.place_memberships.sort_by { [ it.owner? ? 0 : 1, it.user.name ] } %>
            <%= members.any? ? members.map { "#{it.user.name} · #{PlaceMembership::ROLE_LABELS.fetch(it.role)}" }.join(", ") : "Chưa có thành viên" %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

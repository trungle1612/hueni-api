<% content_for :title, "Sửa đặt phòng · hueni admin" %>
<%= render "admin/rooms/header", back: admin_place_calendar_path(@place.slug), back_label: "Lịch phòng", title: "Sửa đặt phòng" %>
<% if @booking.checked_in_at || @booking.can_check_in? %>
  <div id="stay" class="card bg-base-100 shadow-sm mb-3">
    <div class="card-body p-4 flex-row justify-between items-center gap-2">
      <div class="text-sm">
        <% if @booking.checked_out_at %>
          Đã trả phòng lúc <%= @booking.checked_out_at.strftime("%H:%M %d/%m") %> · không sửa được nữa
        <% elsif @booking.checked_in_at %>
          Đã nhận phòng lúc <%= @booking.checked_in_at.strftime("%H:%M %d/%m") %>
        <% else %>
          Khách chưa nhận phòng<% if @booking.room.dirty? %> · <span class="text-warning">Phòng chưa dọn</span><% end %>
        <% end %>
      </div>
      <% if @booking.can_check_in? %>
        <%= check_in_button(@booking, size: "btn-sm") %>
      <% elsif @booking.can_check_out? %>
        <%= check_out_button(@booking, size: "btn-sm") %>
      <% end %>
    </div>
  </div>
<% end %>
<%= render "form", booking: @booking, place: @place %>
<% unless @booking.checked_in_at %>
  <%= button_to "Huỷ đặt phòng", admin_booking_path(@booking), method: :patch, params: { booking: { status: "cancelled" } },
        class: "btn btn-ghost btn-block text-error mt-3", form: { data: { turbo_confirm: "Huỷ đặt phòng này? Phòng sẽ trống lại." } } %>
<% end %>
<% if allowed_to?(:manage, @place) %>
  <section id="history" class="mt-6">
    <h2 class="font-semibold">Lịch sử</h2>
    <%= render "admin/activities/list", versions: @booking.versions.reorder(id: :desc).to_a, show_room: false %>
  </section>
<% end %>

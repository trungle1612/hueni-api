<% content_for :title, "Sửa đặt phòng · hueni admin" %>
<%= render "admin/rooms/header", back: admin_place_calendar_path(@place.slug), back_label: "Lịch phòng", title: "Sửa đặt phòng" %>
<% if @booking.checked_in_at || @booking.can_check_in? %>
  <div id="stay" class="card bg-base-100 shadow-sm mb-3">
    <div class="card-body p-4 flex-row justify-between items-center gap-2">
      <div class="text-sm">
        <% if @booking.checked_out_at %>
          Đã trả phòng lúc <%= @booking.checked_out_at.strftime("%H:%M %d/%m") %> · không sửa được nữa
        <% elsif @booking.checked_in_at %>
          Đã nhận phòng lúc <%= @booking.checked_in_at.strftime("%H:%M %d/%m") %>
        <% else %>
          Khách chưa nhận phòng<% if @booking.room.dirty? %> · <span class="text-warning">Phòng chưa dọn</span><% end %>
        <% end %>
      </div>
      <div class="flex flex-wrap justify-end gap-2">
        <% if allowed_to?(:manage, @place) %>
          <%= undo_button(@booking, :check_out, size: "btn-sm") if @booking.can_undo_check_out? %>
          <%= undo_button(@booking, :check_in, size: "btn-sm") if @booking.can_undo_check_in? %>
        <% end %>
        <% if allowed_to?(:operate, @place) %>
          <%= declare_button(@booking, size: "btn-sm") if @booking.needs_declaration? %>
          <% if @booking.can_check_in? %>
            <%= check_in_button(@booking, size: "btn-sm") %>
          <% elsif @booking.can_check_out? %>
            <%= check_out_button(@booking, size: "btn-sm") %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
<% if allowed_to?(:operate, @place) && @booking.can_check_out? && (free_rooms = @place.rooms.order(:name).select { @booking.can_move_to?(it) }).any? %>
  <%= form_with url: move_admin_booking_path(@booking), id: "move", class: "card bg-base-100 shadow-sm mb-3",
        data: { turbo_confirm: "Đổi phòng cho #{booking_label(@booking)}? Phòng #{@booking.room.name} sẽ chuyển sang chưa dọn." } do |form| %>
    <div class="card-body p-4 flex-row items-center gap-2">
      <%= form.label :room_id, "Đổi sang", class: "text-sm shrink-0" %>
      <%= form.select :room_id, free_rooms.map { [ it.name, it.id ] }, {}, class: "select select-sm flex-1 min-w-0" %>
      <%= form.submit "Đổi phòng", class: "btn btn-sm" %>
    </div>
  <% end %>
<% end %>
<%= render "form", booking: @booking, place: @place %>
<% if @booking.status_in_database == "cancelled" %>
  <p id="cancelled" class="alert alert-soft mt-3">Đã huỷ<%= " · #{@booking.cancel_reason}" if @booking.cancel_reason %></p>
  <%= button_to "Khôi phục đặt phòng", admin_booking_path(@booking), method: :patch, params: { booking: { status: "confirmed" } },
        class: "btn btn-outline btn-primary btn-block mt-3" %>
<% elsif !@booking.checked_in_at %>
  <%# Huỷ asks why (#123); Khác shows a text field. %>
  <details id="huy" class="mt-3" <%= "open" if @booking.errors.include?(:cancel_reason) %>>
    <summary class="btn btn-ghost btn-block text-error">Huỷ đặt phòng</summary>
    <%= form_with model: @booking, url: admin_booking_path(@booking), method: :patch, id: "cancel_form", class: "card bg-base-100 shadow-sm mt-2" do |form| %>
      <div class="card-body p-4 gap-2">
        <%= form.hidden_field :status, value: "cancelled", id: nil %>
        <fieldset class="group flex flex-col gap-2">
          <legend class="font-medium mb-1">Lý do huỷ</legend>
          <% Booking::CANCEL_REASONS.each do |reason| %>
            <label class="flex items-center gap-3 min-h-11 cursor-pointer"><%= form.radio_button :cancel_reason, reason, class: "radio" %><%= reason %></label>
          <% end %>
          <label class="flex items-center gap-3 min-h-11 cursor-pointer"><%= form.radio_button :cancel_reason, "other", class: "radio" %>Khác</label>
          <%= form.text_field :cancel_reason_other, maxlength: 200, placeholder: "Nhập lý do", aria: { label: "Lý do khác" },
                class: "input w-full hidden group-has-[input[value=other]:checked]:block" %>
        </fieldset>
        <%= field_error @booking, :cancel_reason %>
        <p class="text-sm opacity-70">Phòng sẽ trống lại. Đặt phòng đã huỷ vẫn giữ trong lịch sử, khôi phục được.</p>
        <%= form.submit "Xác nhận huỷ", class: "btn btn-error btn-block" %>
      </div>
    <% end %>
  </details>
<% end %>
<% if allowed_to?(:manage, @place) %>
  <section id="history" class="mt-6">
    <h2 class="font-semibold">Lịch sử</h2>
    <%= render "admin/activities/list", versions: @booking.versions.reorder(id: :desc).to_a, show_room: false %>
  </section>
<% end %>

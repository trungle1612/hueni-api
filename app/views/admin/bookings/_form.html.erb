<% rooms = place.rooms.where(active: true).order(:name) if booking.new_record? %>
<% shown = booking.date_problems if booking.errors.any? %>
<% other_errors = booking.errors[:base] - shown.to_a %>
<% first_error = shown.present? ? :dates : (%i[guest_name guest_phone guests] & booking.errors.attribute_names).first %>
<%= form_with model: booking, url: (booking.new_record? ? admin_place_bookings_path(place.slug) : admin_booking_path(booking)),
      html: { novalidate: true }, class: "card bg-base-100 shadow-sm",
      data: { controller: "availability", availability_url_value: availability_admin_place_bookings_path(place.slug, room_id: booking.room_id, booking_id: booking.id) } do |form| %>
  <%# A checked-out stay is history: shown, not editable. %>
  <fieldset class="card-body p-4 gap-4" <%= "disabled" if booking.checked_out_at %>>
    <% if other_errors.any? %>
      <div role="alert" class="alert alert-error alert-soft"><span><%= other_errors.to_sentence %></span></div>
    <% end %>
    <div>
      <% if booking.new_record? && rooms.size > 1 %>
        <%= form.label :room_id, "Phòng", class: "block mb-1 font-medium" %>
        <%= form.select :room_id, rooms.map { [ "#{it.name} · tối đa #{it.max_guests} khách", it.id, { data: { max_guests: it.max_guests } } ] }, {}, required: true,
              class: "select select-lg w-full", data: { action: "availability#check" } %>
      <% else %>
        <div class="mb-1 font-medium">Phòng</div>
        <div class="text-lg font-semibold"><%= booking.room&.name || "Chưa có phòng nào đang nhận khách" %></div>
        <%= form.hidden_field :room_id if booking.new_record? %>
      <% end %>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= form.label :start_date, "Nhận phòng", class: "block mb-1 font-medium" %>
        <%= form.date_field :start_date, required: true, autofocus: first_error == :dates, class: class_names("input input-lg w-full", "input-error": shown.present?),
              aria: { invalid: (true if shown.present?), describedby: ("dates_error" if shown.present?) },
              data: { availability_target: "start", action: "availability#check" } %>
      </div>
      <div>
        <%= form.label :end_date, "Trả phòng", class: "block mb-1 font-medium" %>
        <%= form.date_field :end_date, required: true, class: class_names("input input-lg w-full", "input-error": shown.present?),
              aria: { invalid: (true if shown.present?), describedby: ("dates_error" if shown.present?) },
              data: { availability_target: "end", action: "availability#check" } %>
      </div>
    </div>
    <%# OTA stays and past stays aren't checked: the OTA sold those nights, a checked-out stay is history. %>
    <%= render "admin/bookings/availability", booking: booking, place: place unless booking.checked_out_at || booking.ical? %>
    <div>
      <%= form.label :guest_name, "Tên khách", class: "block mb-1 font-medium" %>
      <%= form.text_field :guest_name, autocomplete: "off", maxlength: 100, autofocus: first_error == :guest_name,
            class: class_names("input input-lg w-full", "input-error": booking.errors.include?(:guest_name)), aria: field_aria(booking, :guest_name) %>
      <%= field_error booking, :guest_name %>
    </div>
    <div>
      <%= form.label :guest_phone, "Số điện thoại", class: "block mb-1 font-medium" %>
      <div class="flex gap-2">
        <%= form.telephone_field :guest_phone, autocomplete: "off", maxlength: 30, autofocus: first_error == :guest_phone,
              class: class_names("input input-lg w-full", "input-error": booking.errors.include?(:guest_phone)), aria: field_aria(booking, :guest_phone) %>
        <% if booking.persisted? && booking.guest_phone_was.present? %>
          <%= link_to "Gọi", "tel:#{booking.guest_phone_was.gsub(/[^\d+]/, "")}", class: "btn btn-outline btn-lg" %>
        <% end %>
      </div>
      <%= field_error booking, :guest_phone %>
    </div>
    <div>
      <%= form.label :guests, class: "block mb-1 font-medium" do %>Số khách<% if booking.room %> (tối đa <span data-availability-target="max"><%= booking.room.max_guests %></span>)<% end %><% end %>
      <%= form.number_field :guests, min: 1, max: booking.room&.max_guests, inputmode: "numeric", data: { availability_target: "guests" }, autofocus: first_error == :guests,
            class: class_names("input input-lg w-full", "input-error": booking.errors.include?(:guests)), aria: field_aria(booking, :guests) %>
      <%= field_error booking, :guests %>
    </div>
    <fieldset>
      <legend class="mb-1 font-medium">Trạng thái</legend>
      <div class="grid grid-cols-2 gap-2">
        <label class="flex items-center gap-3 rounded-box border border-base-300 p-3 min-h-12 cursor-pointer has-checked:border-warning has-checked:bg-warning/5">
          <%= form.radio_button :status, "hold", class: "radio radio-warning" %> Giữ chỗ
        </label>
        <label class="flex items-center gap-3 rounded-box border border-base-300 p-3 min-h-12 cursor-pointer has-checked:border-primary has-checked:bg-primary/5">
          <%= form.radio_button :status, "confirmed", class: "radio radio-primary" %> Đã xác nhận
        </label>
      </div>
    </fieldset>
    <div>
      <%= form.label :note, "Ghi chú", class: "block mb-1 font-medium" %>
      <%= form.text_area :note, rows: 2, class: "textarea textarea-lg w-full" %>
    </div>
    <% if booking.new_record? %>
      <% if booking.room %>
        <div class="flex flex-col gap-2">
          <%= form.submit "Đặt phòng", class: "btn btn-primary btn-lg btn-block" %>
          <%= link_to "Huỷ", admin_place_calendar_path(place.slug), class: "btn btn-ghost btn-block min-h-11" %>
        </div>
      <% end %>
    <% elsif !booking.checked_out_at %>
      <%= form.submit "Lưu", class: "btn btn-primary btn-lg btn-block" %>
    <% end %>
  </fieldset>
<% end %>

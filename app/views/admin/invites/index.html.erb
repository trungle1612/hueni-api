<% content_for :title, "Mã mời · hueni admin" %>

<h1 class="text-xl font-semibold">Mã mời</h1>
<p class="text-sm opacity-70 mb-4">Thêm nhân viên không cần số điện thoại: gửi mã qua Zalo, họ nhập mã khi đăng nhập Mini App hueni.</p>

<div class="flex flex-col gap-6">
  <% @places.each do |place| %>
    <section id="<%= place.slug %>">
      <h2 class="text-lg font-semibold"><%= place.name %></h2>
      <%= render "admin/invites/place", place:, invites: @invites.fetch(place.id, []), title: false %>
    </section>
  <% end %>
</div>

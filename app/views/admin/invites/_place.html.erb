<%# Mã mời (#211): whoever enters it in the Mini App with an unknown Zalo joins with the code's role. %>
<div id="<%= dom_id(place, :invites) %>" class="card bg-base-100 shadow-sm mt-2">
  <div class="card-body p-3 gap-2">
    <% if local_assigns.fetch(:title, true) %><div class="font-semibold text-sm">Mã mời</div><% end %>
    <% invites.each do |invite| %>
      <div class="flex justify-between items-center gap-2">
        <div>
          <span class="font-mono font-semibold select-all"><%= invite.display_code %></span>
          <span class="badge badge-soft badge-sm <%= invite.owner? ? "badge-primary" : "badge-info" %>"><%= PlaceMembership::ROLE_LABELS.fetch(invite.role) %></span>
          <div class="text-xs opacity-60">Còn <%= invite.max_uses - invite.uses_count %> lần · hết hạn <%= l(invite.expires_at, format: "%d/%m %H:%M") %></div>
        </div>
        <%= button_to "Thu hồi", admin_place_invite_path(place.slug, invite), method: :delete, class: "btn btn-ghost btn-xs text-error",
              form: { data: { turbo_confirm: "Thu hồi mã #{invite.display_code}? Mã này sẽ không dùng được nữa." } } %>
      </div>
    <% end %>
    <%= form_with scope: :invite, url: admin_place_invites_path(place.slug), class: "flex flex-wrap items-end gap-2" do |form| %>
      <% if Current.user.admin? %>
        <%= form.select :role, PlaceMembership::ROLE_LABELS.invert, { selected: "staff" }, aria: { label: "Vai trò" }, class: "select select-sm w-auto" %>
        <label class="text-xs">Số lần <%= form.number_field :max_uses, value: 1, min: 1, max: 20, class: "input input-sm w-16" %></label>
        <label class="text-xs">Số ngày <%= form.number_field :days, value: 7, min: 1, max: 30, class: "input input-sm w-16" %></label>
      <% end %>
      <%= form.submit "Tạo mã mời", class: "btn btn-sm" %>
    <% end %>
    <div class="text-xs opacity-60">Gửi mã cho người mới qua Zalo; họ nhập mã khi đăng nhập Mini App hueni.<%= " Mã nhân viên: dùng 1 lần, trong 7 ngày." unless Current.user.admin? %></div>
  </div>
</div>

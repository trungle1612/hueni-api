<% first_error = room.errors.attribute_names.first %>
<%# A new room redirects to its #kenh-ota; Turbo drops a redirect's anchor, a plain submit keeps it. %>
<%= form_with model: room, url: (room.new_record? ? admin_place_rooms_path(place.slug) : admin_room_path(room)), html: { novalidate: true }, data: { turbo: room.persisted? }, class: "card bg-base-100 shadow-sm" do |form| %>
  <div class="card-body p-4 gap-4">
    <% if room.persisted? %><h2 class="font-semibold">Thông tin phòng</h2><% end %>
    <div>
      <%= form.label :name, "Tên phòng", class: "block mb-1 font-medium" %>
      <%= form.text_field :name, required: true, autocomplete: "off", autofocus: first_error == :name,
            class: class_names("input input-lg w-full", "input-error": room.errors.include?(:name)),
            aria: field_aria(room, :name, hint: "name_hint") %>
      <p id="name_hint" class="text-sm opacity-70 mt-1">Ví dụ: 101, Sen, Gia đình. Không cần ghi chữ "Phòng".</p>
      <%= field_error room, :name %>
    </div>
    <div>
      <%= form.label :max_guests, "Số khách tối đa", class: "block mb-1 font-medium" %>
      <%= form.number_field :max_guests, min: 1, required: true, autofocus: first_error == :max_guests,
            class: class_names("input input-lg w-full", "input-error": room.errors.include?(:max_guests)),
            aria: field_aria(room, :max_guests, hint: "max_guests_hint") %>
      <p id="max_guests_hint" class="text-sm opacity-70 mt-1">Tính cả trẻ em.</p>
      <%= field_error room, :max_guests %>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= form.label :price, "Giá mỗi đêm (₫)", class: "block mb-1 font-medium" %>
        <%= price_field form, :price, hint: "price_hint", autofocus: first_error == :price %>
        <%= field_error room, :price %>
      </div>
      <div>
        <%= form.label :weekend_price, "Thứ 6, thứ 7 (₫)", class: "block mb-1 font-medium" %>
        <%= price_field form, :weekend_price, hint: "price_hint", placeholder: "Như thường", autofocus: first_error == :weekend_price %>
        <%= field_error room, :weekend_price %>
      </div>
      <p id="price_hint" class="col-span-2 text-sm opacity-70">Không bắt buộc. Ví dụ 450.000 hoặc 450k. Giá mới áp dụng cho đặt phòng tạo sau khi lưu, đặt phòng đã có giữ giá cũ. Chỉ chủ cơ sở thấy giá.</p>
    </div>
    <% if room.persisted? %>
      <fieldset class="group flex flex-col gap-2">
        <legend class="mb-1 font-medium">Trạng thái</legend>
        <label class="flex items-start gap-3 rounded-box border border-base-300 p-3 cursor-pointer has-checked:border-success has-checked:bg-success/5">
          <%= form.radio_button :state, "active", class: "radio radio-success mt-0.5" %>
          <span><span class="block font-medium">Nhận khách</span>
            <span class="text-sm opacity-70">Hiện là phòng trống trên hueni.me khi chưa có khách.</span></span>
        </label>
        <label class="flex items-start gap-3 rounded-box border border-base-300 p-3 cursor-pointer has-checked:border-neutral has-checked:bg-base-200">
          <%= form.radio_button :state, "maintenance", class: "radio mt-0.5" %>
          <span><span class="block font-medium">Bảo trì</span>
            <span class="text-sm opacity-70">Đang sửa chữa đến ngày dự kiến: không nhận đặt phòng, không hiện trên hueni.me. Hết hạn thì phòng chuyển Chưa dọn.</span></span>
        </label>
        <%# Shown only while Bảo trì is picked. %>
        <div class="hidden group-has-[input[value=maintenance]:checked]:flex flex-col gap-3 pl-4">
          <div>
            <%= form.label :maintenance_reason, "Lý do", class: "block mb-1 font-medium" %>
            <%= form.text_field :maintenance_reason, maxlength: 200, placeholder: "Ví dụ: hỏng máy lạnh",
                  class: class_names("input w-full", "input-error": room.errors.include?(:maintenance_reason)) %>
            <%= field_error room, :maintenance_reason %>
          </div>
          <div>
            <%= form.label :maintenance_until, "Dự kiến xong", class: "block mb-1 font-medium" %>
            <%= form.date_field :maintenance_until, min: Date.current, value: room.maintenance_until || Date.current,
                  class: class_names("input w-full", "input-error": room.errors.include?(:maintenance_until)) %>
            <%= field_error room, :maintenance_until %>
          </div>
        </div>
        <label class="flex items-start gap-3 rounded-box border border-base-300 p-3 cursor-pointer has-checked:border-warning has-checked:bg-warning/5">
          <%= form.radio_button :state, "paused", class: "radio radio-warning mt-0.5" %>
          <span><span class="block font-medium">Tạm ngưng</span>
            <span class="text-sm opacity-70">Không cho thuê một thời gian dài: không hiện trên hueni.me và lịch phòng. Lịch sử vẫn giữ.</span></span>
        </label>
        <%= field_error room, :base %>
      </fieldset>
    <% else %>
      <p class="text-sm">Phòng hiện trên hueni.me ngay sau khi lưu, là phòng trống khi chưa có khách.</p>
    <% end %>
    <div class="flex flex-col gap-2">
      <%= form.submit room.persisted? ? "Lưu" : "Thêm phòng", class: "btn btn-primary btn-lg btn-block" %>
      <%= link_to "Huỷ", admin_rooms_path(anchor: place.slug), class: "btn btn-ghost btn-block min-h-11" %>
    </div>
  </div>
<% end %>

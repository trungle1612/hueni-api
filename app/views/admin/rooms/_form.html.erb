<%= form_with model: room, url: (room.new_record? ? admin_place_rooms_path(place.slug) : admin_room_path(room)), class: "card bg-base-100 shadow-sm" do |form| %>
  <div class="card-body p-4 gap-4">
    <% if room.persisted? %><h2 class="font-semibold">Thông tin phòng</h2><% end %>
    <% if room.errors.any? %>
      <div role="alert" class="alert alert-error alert-soft">
        <ul><% room.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>
    <div>
      <%= form.label :name, "Tên phòng", class: "block mb-1 font-medium" %>
      <%= form.text_field :name, required: true, class: "input input-lg w-full" %>
    </div>
    <div>
      <%= form.label :max_guests, "Số khách tối đa", class: "block mb-1 font-medium" %>
      <%= form.number_field :max_guests, min: 1, required: true, class: "input input-lg w-full" %>
    </div>
    <div>
      <%= form.label :price, "Giá mỗi đêm (₫)", class: "block mb-1 font-medium" %>
      <%= form.text_field :price, value: (number_with_delimiter(room.price, delimiter: ".") if room.price), inputmode: "numeric", class: "input input-lg w-full", aria: { describedby: "price_hint" } %>
      <p id="price_hint" class="text-sm opacity-70 mt-1">Chỉ hiển thị trong trang quản trị.</p>
    </div>
    <fieldset class="flex flex-col gap-2">
      <legend class="mb-1 font-medium">Trên hueni.me</legend>
      <label class="flex items-start gap-3 rounded-box border border-base-300 p-3 cursor-pointer has-checked:border-success has-checked:bg-success/5">
        <%= form.radio_button :active, true, class: "radio radio-success mt-0.5" %>
        <span><span class="block font-medium">Nhận khách</span>
          <span class="text-sm opacity-70">Hiện là phòng trống trên hueni.me khi chưa có khách.</span></span>
      </label>
      <label class="flex items-start gap-3 rounded-box border border-base-300 p-3 cursor-pointer has-checked:border-warning has-checked:bg-warning/5">
        <%= form.radio_button :active, false, class: "radio radio-warning mt-0.5" %>
        <span><span class="block font-medium">Tạm ngưng</span>
          <span class="text-sm opacity-70">Không hiện trên hueni.me và lịch phòng, ví dụ khi đang sửa chữa. Lịch sử vẫn giữ.</span></span>
      </label>
    </fieldset>
    <%= form.submit "Lưu", class: "btn btn-primary btn-lg btn-block" %>
  </div>
<% end %>

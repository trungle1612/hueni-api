<% user = @membership.user %>
<% content_for :title, "#{user.name} · hueni admin" %>
<%= render "admin/rooms/header", back: admin_place_path(@place.slug), back_label: @place.name, title: user.name %>

<% if (link = flash[:setup_link]) %><%= render "admin/members/setup_link", user:, link: %><% end %>

<%= form_with model: @membership, url: admin_place_member_path(@place.slug, @membership), class: "card bg-base-100 shadow-sm" do |form| %>
  <div class="card-body p-4 gap-3">
    <% if @membership.errors.any? %>
      <div role="alert" class="alert alert-error alert-soft">
        <ul><% @membership.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>
    <div class="text-sm opacity-70"><%= phone(user.phone_number) %></div>
    <%= form.label :role, "Vai trò tại #{@place.name}", class: "label text-sm" %>
    <%= form.select :role, PlaceMembership::ROLE_LABELS.invert, {}, class: "select w-full" %>
    <%= form.submit "Lưu", class: "btn btn-primary btn-block mt-2" %>
  </div>
<% end %>

<% if can_send_link?(user) %>
  <%= button_to "Tạo link đặt lại mật khẩu", setup_link_admin_place_member_path(@place.slug, @membership), class: "btn btn-outline btn-error btn-block mt-4",
        form: { data: { turbo_confirm: "Khoá mật khẩu hiện tại của #{user.name} và tạo link mới?" } } %>
<% end %>
<%= button_to "Xoá khỏi #{@place.name}", admin_place_member_path(@place.slug, @membership), method: :delete, class: "btn btn-ghost btn-block text-error mt-2",
      form: { data: { turbo_confirm: "Xoá #{user.name} khỏi #{@place.name}? Tài khoản vẫn được giữ." } } %>

<% content_for :title, "#{@user.name} · hueni admin" %>
<%= render "admin/rooms/header", back: admin_users_path, back_label: "Người dùng", title: @user.name %>

<% if (link = flash[:setup_link]) %><%= render "admin/members/setup_link", user: @user, link: %><% end %>

<%= render "form", user: @user %>

<% unless @user == Current.user %>
  <div class="card bg-base-100 shadow-sm mt-4">
    <div class="card-body p-4 gap-2">
      <div class="font-semibold">Quên mật khẩu?</div>
      <div class="text-sm opacity-70">Tạo link mới để <%= @user.name %> tự đặt lại mật khẩu. Mật khẩu cũ và các link cũ hết dùng được; <%= @user.name %> bị đăng xuất khỏi mọi thiết bị.</div>
      <%= button_to "Tạo link đặt lại mật khẩu", reset_password_admin_user_path(@user), class: "btn btn-outline btn-error btn-block",
            form: { data: { turbo_confirm: "Khoá mật khẩu hiện tại của #{@user.name} và tạo link mới?" } } %>
    </div>
  </div>
<% end %>

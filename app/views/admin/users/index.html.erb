<% content_for :title, "Người dùng · hueni admin" %>

<div class="flex justify-between items-center mb-4">
  <h1 class="text-xl font-semibold">Người dùng</h1>
  <%= link_to "+ Thêm", new_admin_user_path, class: "btn btn-primary btn-sm" %>
</div>

<% pending, decided = @registrations.partition(&:pending?) %>
<% linked_zalo_ids = User.where(zalo_id: pending.map(&:zalo_id)).pluck(:zalo_id) %>
<% if pending.any? %>
  <section id="registrations" class="mb-6">
    <h2 class="font-semibold mb-2">Yêu cầu đăng ký <span class="badge badge-soft badge-error badge-sm"><%= pending.size %></span></h2>
    <div class="flex flex-col gap-2">
      <% pending.each do |registration| %>
        <%= link_to admin_registration_request_path(registration), id: dom_id(registration), class: "card bg-base-100 shadow-sm hover:shadow-md transition-shadow" do %>
          <div class="card-body p-3 gap-0">
            <div class="font-semibold"><%= registration.name %></div>
            <div class="text-sm opacity-70">
              <%= registration.place ? registration.place.name : "\"#{registration.place_name}\" (chưa có trên hueni)" %>
              · gửi lúc <%= registration.created_at.strftime("%H:%M %d/%m") %>
            </div>
            <% flags = [ ("Zalo đã có tài khoản" if registration.zalo_id.in?(linked_zalo_ids)),
                         ("Đã có chủ" if registration.place_owners.any?),
                         ("Không có SĐT để gọi" unless registration.verifiable?) ].compact %>
            <% if flags.any? %>
              <div class="flex flex-wrap gap-1 mt-1"><% flags.each do |flag| %><span class="badge badge-soft badge-warning badge-sm"><%= flag %></span><% end %></div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
<% if decided.any? %>
  <details id="decided_registrations" class="mb-6">
    <summary class="text-sm opacity-70 cursor-pointer">Yêu cầu đăng ký đã xử lý (<%= decided.size %>)</summary>
    <ul class="mt-2 bg-base-100 rounded-box shadow-sm divide-y divide-base-200 text-sm">
      <% decided.each do |registration| %>
        <li class="p-3">
          <%= link_to registration.name, admin_registration_request_path(registration), class: "link font-semibold" %>
          · <%= registration.homestay_name %>
          · <%= registration.approved? ? "Đã duyệt" : "Đã từ chối" %> bởi <%= registration.decided_by&.name %>
          <%= registration.decided_at&.strftime("%d/%m/%Y") %>
        </li>
      <% end %>
    </ul>
  </details>
<% end %>

<div class="flex flex-col gap-3">
  <% @users.each do |user| %>
    <%= link_to edit_admin_user_path(user), id: dom_id(user), class: "card bg-base-100 shadow-sm hover:shadow-md transition-shadow" do %>
      <div class="card-body p-4 gap-1">
        <div class="flex justify-between items-start gap-2">
          <div class="font-semibold"><%= user.name %><%= " (bạn)" if user == Current.user %></div>
          <span class="badge badge-soft badge-sm <%= user.admin? ? "badge-primary" : "badge-neutral" %>"><%= user.role_label %></span>
        </div>
        <div class="flex items-center gap-2 text-sm"><span class="opacity-70"><%= phone(user.phone_number) %></span><%= zalo_badge(user) %></div>
        <% if user.place_memberships.any? %>
          <div class="text-xs opacity-60"><%= user.place_memberships.sort_by { it.place.name }.map { "#{it.place.name} (#{it.role_label})" }.join(", ") %></div>
        <% elsif !user.admin? %>
          <div><span class="badge badge-soft badge-warning badge-sm">Chưa gán homestay</span></div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

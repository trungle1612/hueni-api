<%= form_with model: user, url: (user.new_record? ? admin_users_path : admin_user_path(user)), class: "card bg-base-100 shadow-sm" do |form| %>
  <div class="card-body p-4 gap-3">
    <% if user.errors.any? %>
      <div role="alert" class="alert alert-error alert-soft">
        <ul><% user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>
    <div>
      <%= form.label :name, "Tên", class: "label text-sm mb-1" %>
      <%= form.text_field :name, required: true, class: "input w-full" %>
    </div>
    <div>
      <%= form.label :phone_number, "Số điện thoại (dùng để đăng nhập)", class: "label text-sm mb-1" %>
      <%= form.telephone_field :phone_number, required: true, value: phone(user.phone_number), class: "input w-full" %>
      <div class="text-xs opacity-60 mt-1">Nhập kiểu nào cũng được: 0912345678, 0912 345 678, +84 912 345 678</div>
    </div>
    <div>
      <%= form.label :role, "Vai trò", class: "label text-sm mb-1" %>
      <%= form.select :role, User::ROLE_LABELS.invert, {}, class: "select w-full", disabled: user == Current.user %>
      <% if user == Current.user %><div class="text-xs opacity-60 mt-1">Không thể đổi vai trò của chính bạn.</div><% end %>
    </div>
    <fieldset>
      <legend class="label text-sm mb-1">Homestay</legend>
      <div class="text-xs opacity-60 mb-2">Quản trị viên luôn quản lý được mọi homestay.</div>
      <% roles = user.place_memberships.to_h { [ it.place_id, it.role ] } %>
      <div class="flex flex-col gap-2 max-h-80 overflow-y-auto">
        <% Place.order(:name).each do |place| %>
          <label class="flex items-center justify-between gap-2 text-sm">
            <span class="truncate"><%= place.name %></span>
            <%= select_tag "memberships[#{place.id}]",
                  options_for_select([ [ "—", "" ] ] + PlaceMembership::ROLE_LABELS.invert.to_a, params.dig(:memberships, place.id.to_s) || roles[place.id]),
                  class: "select select-sm w-36", aria: { label: "Vai trò tại #{place.name}" } %>
          </label>
        <% end %>
      </div>
    </fieldset>
    <% if user.new_record? %><div class="text-xs opacity-60">Sau khi lưu, bạn nhận một link để gửi qua Zalo; người dùng mở link và tự chọn mật khẩu.</div><% end %>
    <%= form.submit user.new_record? ? "Tạo tài khoản" : "Lưu", class: "btn btn-primary btn-block mt-2" %>
  </div>
<% end %>

<% content_for :title, "Đăng nhập · hueni" %>

<div class="flex flex-col min-h-full px-6">
  <div class="pt-16 flex flex-col gap-1">
    <b class="text-xl font-bold tracking-tight">hueni</b>
    <span class="text-pms-text-2">Quản lý phòng cho chủ homestay và nhân viên</span>
  </div>

  <div class="pt-10 flex flex-col gap-3">
    <h1 class="text-[22px] leading-tight font-semibold">Đăng nhập bằng Zalo</h1>
    <p class="text-pms-text-2">Dùng tài khoản Zalo đã liên kết với hueni. Không cần mật khẩu.</p>
    <%= render "sessions/zalo_button" %>
    <% if OmniAuth.config.test_mode || Rails.configuration.x.zalo_configured %>
      <p class="mt-3 text-[13px] font-semibold text-pms-text-2">Chưa có tài khoản?</p>
      <%= render "sessions/zalo_button", label: "Đăng ký làm chủ homestay bằng Zalo", register: true %>
    <% end %>
  </div>

  <p class="mt-8 text-[13px] text-pms-text-2">Nhân viên lần đầu dùng? Nhờ chủ homestay thêm số điện thoại của bạn. Đổi Zalo hoặc mất điện thoại? Nhờ quản trị viên hoặc chủ homestay gửi link liên kết mới.</p>

  <%# Password login is for admins only (SessionsController#create). %>
  <details class="mt-6" <%= "open" if params[:admin] %>>
    <summary class="text-xs text-pms-text-2 cursor-pointer min-h-11 flex items-center">Quản trị viên đăng nhập bằng mật khẩu</summary>
    <%= form_with url: session_path, class: "flex flex-col gap-3 mt-2" do |form| %>
      <div class="flex flex-col gap-1.5">
        <%= form.label :phone_number, "Số điện thoại", class: "text-[13px] font-semibold" %>
        <%= form.telephone_field :phone_number, required: true, autocomplete: "username", class: "pms-input" %>
      </div>
      <div class="flex flex-col gap-1.5">
        <%= form.label :password, "Mật khẩu", class: "text-[13px] font-semibold" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "pms-input" %>
      </div>
      <%= form.submit "Đăng nhập", class: "pms-btn w-full mt-1" %>
    <% end %>
  </details>
</div>

<!DOCTYPE html>
<html lang="vi" class="pms-app">
  <head>
    <title><%= content_for(:title) || "hueni" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#ffffff">
    <meta name="application-name" content="hueni">
    <meta name="apple-mobile-web-app-title" content="hueni">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="zalo-platform-site-verification" content="J-M3AQoMDmHxgBbTcu0e0XoghWFmt7LVDpSs" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script>if ("serviceWorker" in navigator) navigator.serviceWorker.register("/service-worker.js")</script>
  </head>

  <body class="bg-pms-bg text-pms-text font-pms text-sm leading-[1.45] tabular-nums">
    <div class="mx-auto w-full max-w-xl min-h-dvh flex flex-col">
      <%= yield :bar %>
      <% flash.to_hash.slice("notice", "alert").each do |type, message| %>
        <div role="<%= type == "alert" ? "alert" : "status" %>" class="mx-4 mt-4 rounded-md border px-3 py-2.5 text-[13px] font-medium <%= type == "alert" ? "border-pms-danger bg-pms-danger-bg text-pms-danger" : "border-pms-pos bg-pms-pos-bg text-pms-pos" %>"><%= message %></div>
      <% end %>
      <main class="flex-1 pb-6"><%= yield %></main>
      <%= render "pms/nav" if authenticated? %>
    </div>
  </body>
</html>

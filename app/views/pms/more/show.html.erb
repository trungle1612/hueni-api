<% content_for :title, "Thêm · hueni" %>
<% user = Current.user %>
<% chevron = tag.svg(tag.path(d: "M9 6l6 6-6 6"), class: "flex-none text-pms-text-2", width: 18, height: 18, viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": 2, "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden": true) %>
<% row = "flex items-center gap-3 min-h-13 px-3 py-2 no-underline w-full text-left cursor-pointer" %>
<% switcher = capture do %>
  <% if current_place %>
    <button type="button" popovertarget="places_sheet" aria-label="Đổi cơ sở, đang xem <%= current_place.name %>"
            class="pms-btn px-3 gap-2 max-w-[200px]"><span class="truncate"><%= current_place.name %></span>
      <svg aria-hidden="true" class="flex-none" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
    </button>
  <% end %>
<% end %>
<% content_for :bar, render("pms/bar", title: "Thêm", actions: switcher) %>

<% groups = {
  "Vận hành hằng ngày" => [ [ "Tìm đặt phòng", "Tên, số điện thoại hoặc mã đặt phòng", pms_search_path ] ],
  "Thiết lập · chủ cơ sở" => ([ [ "Danh sách phòng", "#{current_place.rooms.count} phòng · thêm, sửa, giá", pms_rooms_path ] ] if current_place && allowed_to?(:manage, current_place)),
  "Trang quản lý" => [ [ "Mở trang quản lý", "Các mục chưa có trong ứng dụng", admin_root_path ] ]
}.compact %>
<% groups.each do |title, items| %>
  <section class="px-4 pt-4" aria-label="<%= title %>">
    <h2 class="pms-sec-h"><%= title %></h2>
    <div class="pms-panel divide-y divide-pms-border">
      <% items.each do |label, sub, path| %>
        <%= link_to path, class: row do %>
          <span class="flex-1 min-w-0"><span class="block font-semibold"><%= label %></span><span class="block text-[13px] text-pms-text-2 truncate"><%= sub %></span></span><%= chevron %>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>

<section id="account" class="px-4 pt-4 pb-6" aria-labelledby="account_h">
  <h2 id="account_h" class="pms-sec-h">Tài khoản</h2>
  <div class="pms-panel divide-y divide-pms-border">
    <div class="<%= row %> cursor-auto">
      <span class="flex-1 min-w-0">
        <span class="block font-semibold"><%= user.name %></span>
        <span class="block text-[13px] text-pms-text-2 truncate"><%= [ ({ "owner" => "Chủ cơ sở", "staff" => "Lễ tân" }[user.role_at(current_place)] if current_place), user.phone_number ].compact.join(" · ").presence || "Chưa thuộc cơ sở nào" %></span>
      </span>
    </div>
    <%= link_to pms_legal_path, class: row do %>
      <span class="flex-1 min-w-0"><span class="block font-semibold">Điều khoản và quyền riêng tư</span><span class="block text-[13px] text-pms-text-2 truncate">Điều khoản sử dụng, chính sách bảo mật, hỗ trợ</span></span><%= chevron %>
    <% end %>
    <%= button_to "Đăng xuất", session_path, method: :delete, class: "#{row} font-semibold text-pms-danger", form_class: "w-full" %>
    <button type="button" popovertarget="delete_sheet" class="<%= row %> font-semibold text-pms-danger">Xoá tài khoản</button>
  </div>
</section>

<% if current_place %>
  <div id="places_sheet" popover class="pms-sheet max-h-[90dvh] overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="places_sheet_t">
    <div class="flex flex-col gap-3">
      <h2 id="places_sheet_t" class="text-base font-semibold">Chọn cơ sở</h2>
      <div class="pms-panel divide-y divide-pms-border">
        <% places.each do |place| %>
          <% if place == current_place %>
            <div class="<%= row %> cursor-auto" aria-current="true">
              <span class="flex-1 min-w-0 font-semibold truncate"><%= place.name %></span>
              <span class="pms-badge pms-badge-pos">Đang xem</span>
            </div>
          <% else %>
            <%= button_to pms_place_path(place.slug), method: :patch, class: row, form_class: "w-full" do %>
              <span class="flex-1 min-w-0 truncate"><%= place.name %></span><span class="text-pms-primary font-semibold">Chọn</span>
            <% end %>
          <% end %>
        <% end %>
      </div>
      <p class="text-[13px] text-pms-text-2">Đặt phòng, lịch và báo cáo luôn theo từng cơ sở.</p>
      <button type="button" class="pms-btn pms-btn-ghost w-full" popovertarget="places_sheet" popovertargetaction="hide">Đóng</button>
    </div>
  </div>
<% end %>

<% sole = user.sole_owned_places.map(&:name) %>
<div id="delete_sheet" popover class="pms-sheet max-h-[90dvh] overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="delete_sheet_t">
  <div class="flex flex-col gap-3">
    <h2 id="delete_sheet_t" class="text-base font-semibold">Xoá tài khoản hueni?</h2>
    <ul class="pl-4 list-disc flex flex-col gap-1 text-[13px] text-pms-text-2">
      <li>Tên, số điện thoại và liên kết Zalo của bạn bị xoá. Bạn rời mọi cơ sở và bị đăng xuất.</li>
      <li>Cơ sở vẫn giữ đặt phòng, tiền thu và nhật ký bạn đã làm, ghi tên là “<%= User::DELETED_NAME %>”.</li>
      <% if sole.any? %>
        <li id="sole_owner" class="text-pms-danger"><b>Bạn là chủ duy nhất của <%= sole.to_sentence(words_connector: ", ", two_words_connector: ", ", last_word_connector: ", ") %>:</b> mọi đặt phòng, tiền thu và hồ sơ khách của cơ sở đó cũng bị xoá, nhân viên bị gỡ khỏi cơ sở. Phòng và cài đặt vẫn giữ.</li>
      <% end %>
      <li>Không hoàn tác được.</li>
    </ul>
    <%= button_to "Xoá tài khoản", pms_account_path, method: :delete, class: "pms-btn pms-btn-danger w-full", form_class: "w-full" %>
    <button type="button" class="pms-btn pms-btn-ghost w-full" popovertarget="delete_sheet" popovertargetaction="hide">Không xoá</button>
  </div>
</div>

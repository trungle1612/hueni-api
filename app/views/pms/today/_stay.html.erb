<%# One Hôm nay row. step: :check_in / :check_out = the row's button, nil = none (Đang ở, Ngày mai).
    Money due, a dirty room or a missing head count first open a bottom sheet; otherwise the tap does it. -%>
<% due = booking.due if booking.due&.positive? %>
<div id="<%= dom_id(booking, :today) %>" class="flex items-center gap-3 min-h-15 px-3 py-2">
  <%= link_to pms_booking_href(booking), class: "flex-1 min-w-0 flex items-center gap-3 min-h-11 no-underline" do %>
    <span class="flex-none min-w-9 max-w-24 text-[15px] font-semibold truncate"><%= booking.room.name %></span>
    <span class="flex-1 min-w-0">
      <span class="block font-semibold truncate"><%= booking.label %></span>
      <span class="block text-[13px] text-pms-text-2 truncate"><%= pms_stay_meta(booking, departing: step == :check_out) %></span>
      <% if due %><span class="block text-[13px] font-semibold text-pms-warn">Còn thu <%= pms_money(due) %></span><% end %>
    </span>
  <% end %>
  <% if step %>
    <% check_in = step == :check_in %>
    <% path = check_in ? pms_stay_check_in_path(booking) : pms_stay_check_out_path(booking) %>
    <% verb = check_in ? "nhận phòng" : "trả phòng" %>
    <% aria = "#{verb.upcase_first} #{booking.room.name}, #{booking.label}" %>
    <% dirty = check_in && booking.room.dirty? %>
    <% ask_guests = check_in && !booking.guests %>
    <% if due || dirty || ask_guests %>
      <% sheet = dom_id(booking, :sheet) %>
      <button type="button" class="pms-btn px-3" popovertarget="<%= sheet %>" aria-label="<%= aria %>"><%= check_in ? "Nhận" : "Trả" %></button>
      <div id="<%= sheet %>" popover class="pms-sheet" role="dialog" aria-modal="true" aria-labelledby="<%= sheet %>_t">
        <%= form_with url: path, class: "flex flex-col gap-3" do |form| %>
          <h2 id="<%= sheet %>_t" class="text-base font-semibold"><%= verb.upcase_first %> <%= booking.room.name %> · <%= booking.label %></h2>
          <% if dirty %>
            <div class="pms-notice" role="alert">Phòng <%= booking.room.name %> chưa dọn xong. Nên đổi sang phòng đã sẵn sàng, hoặc mời khách chờ.</div>
          <% end %>
          <% if ask_guests %>
            <label class="flex flex-col gap-1 font-medium">Số khách
              <%= form.number_field :guests, in: 1..booking.room.max_guests, required: true, inputmode: "numeric", class: "pms-input" %>
            </label>
          <% end %>
          <% if due %>
            <dl class="pms-panel divide-y divide-pms-border">
              <% [ [ "Tổng tiền phòng", booking.total ], [ "Đã thanh toán", booking.paid ] ].each do |label, amount| %>
                <div class="flex justify-between gap-3 px-3 py-2.5"><dt class="text-pms-text-2"><%= label %></dt><dd class="font-semibold"><%= pms_money(amount) %></dd></div>
              <% end %>
              <div class="flex justify-between gap-3 px-3 py-2.5"><dt class="text-pms-text-2">Còn phải thu</dt><dd class="font-semibold text-pms-warn"><%= pms_money(due) %></dd></div>
            </dl>
            <%= form.button "Đã thu #{pms_money(due)}, #{verb}", name: "collect", value: "1", class: "pms-btn pms-btn-primary w-full" %>
            <%= form.button "#{verb.upcase_first}, ghi nợ", class: "pms-btn w-full" %>
          <% else %>
            <%= form.button dirty ? "Vẫn #{verb}" : verb.upcase_first, class: "pms-btn pms-btn-primary w-full" %>
          <% end %>
          <button type="button" class="pms-btn pms-btn-ghost w-full" popovertarget="<%= sheet %>" popovertargetaction="hide">Đóng</button>
        <% end %>
      </div>
    <% else %>
      <%= button_to check_in ? "Nhận" : "Trả", path, class: "pms-btn px-3", "aria-label": aria %>
    <% end %>
  <% elsif @tomorrow %>
    <span class="flex-none rounded px-1.5 text-xs font-semibold leading-5 bg-pms-muted text-pms-text-2">Ngày mai</span>
  <% end %>
</div>

<% content_for :title, "Hôm nay · hueni" %>
<% day = @tomorrow ? "Xem trước #{pms_day(Date.current.next_day)}" : pms_day(Date.current) %>
<% content_for :bar, render("pms/bar", title: "Hôm nay", sub: [ day, current_place&.name ].compact.join(" · ")) %>

<% if current_place %>
  <% t = @today %>
  <nav class="flex bg-pms-surface border-b border-pms-border px-2" aria-label="Chọn ngày">
    <% [ [ "Hôm nay", pms_today_path, !@tomorrow ], [ "Ngày mai", pms_today_path(day: "mai"), @tomorrow ] ].each do |label, path, on| %>
      <%= link_to label, path, "aria-current": ("page" if on),
            class: "flex items-center min-h-11 px-2.5 border-b-2 no-underline #{on ? "border-pms-primary font-semibold" : "border-transparent text-pms-text-2 font-medium"}" %>
    <% end %>
  </nav>

  <div class="px-4 pt-4">
    <div id="stats" class="pms-panel grid grid-cols-4 divide-x divide-pms-border">
      <% [ [ @tomorrow ? "Sẽ đến" : "Chờ đến", t.arrivals.size ], [ @tomorrow ? "Sẽ đi" : "Chờ đi", t.departures.size ],
           [ @tomorrow ? "Dự kiến ở" : "Đang ở", t.in_house.size, "/#{@open_rooms}" ], [ "Cần dọn", t.dirty_rooms.size ] ].each do |label, count, of| %>
        <div class="flex flex-col gap-0.5 px-3 py-2.5 min-w-0">
          <b class="text-xl leading-tight font-semibold"><%= count %><% if of %><span class="text-[13px]"><%= of %></span><% end %></b>
          <span class="text-xs text-pms-text-2 truncate"><%= label %></span>
        </div>
      <% end %>
    </div>
  </div>

  <% if !@tomorrow && t.issues.any? %>
    <div id="issues" class="px-4 pt-4 flex flex-col gap-1.5">
      <% t.issues.each do |issue| %>
        <%= link_to issue.kind == :clean ? "#can-don" : pms_booking_href(issue.booking), class: "pms-notice" do %>
          <span class="flex-1 min-w-0"><b class="font-semibold"><%= issue.title %></b> · <%= issue.detail %></span><b>Xem</b>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% sections = [
       [ "nhan-phong", "Nhận phòng", t.arrivals, :check_in, "Không có khách đến." ],
       [ "tra-phong", "Trả phòng", t.departures, :check_out, "Không có khách đi." ],
       [ "dang-o", @tomorrow ? "Dự kiến ở" : "Đang ở", t.in_house, nil, "Không có khách đang ở." ]
     ] %>
  <% sections.each_with_index do |(id, label, bookings, step, empty), i| %>
    <section class="px-4 pt-4" aria-labelledby="<%= id %>">
      <h2 id="<%= id %>" class="pms-sec-h flex items-baseline justify-between gap-2">
        <span><%= label %> · <%= bookings.size %></span>
        <% if i.zero? %><%= link_to "Lịch", admin_place_calendar_path(current_place.slug), class: "text-pms-primary font-semibold no-underline" %><% end %>
      </h2>
      <div class="pms-panel divide-y divide-pms-border">
        <%= render partial: "stay", collection: bookings, as: :booking, locals: { step: (step unless @tomorrow) } %>
        <% if bookings.empty? %><div class="px-3 py-4 text-[13px] text-pms-text-2"><%= empty %></div><% end %>
      </div>
    </section>
  <% end %>

  <section id="can-don" class="px-4 pt-4" aria-labelledby="can-don-h">
    <h2 id="can-don-h" class="pms-sec-h">Cần dọn · <%= t.dirty_rooms.size %></h2>
    <div class="pms-panel divide-y divide-pms-border">
      <% t.dirty_rooms.each do |room| %>
        <div class="flex items-center gap-3 min-h-15 px-3 py-2">
          <span class="flex-1 min-w-0 font-semibold truncate">Phòng <%= room.name %></span>
          <% if @tomorrow %>
            <span class="rounded px-1.5 text-xs font-semibold leading-5 bg-pms-muted text-pms-text-2">Ngày mai</span>
          <% else %>
            <%= button_to "Đã dọn", pms_room_clean_path(room), class: "pms-btn px-3", "aria-label": "Đã dọn phòng #{room.name}" %>
          <% end %>
        </div>
      <% end %>
      <% if t.dirty_rooms.empty? %><div class="px-3 py-4 text-[13px] text-pms-text-2">Không có phòng cần dọn.</div><% end %>
    </div>
  </section>

  <% if (toast = flash[:toast]) %>
    <div class="pms-toast" role="status">
      <span class="flex-1"><%= toast %></span>
      <% step = flash[:undo]&.last %>
      <% if @undo && (step == "check_in" ? @undo.can_undo_check_in? : @undo.can_undo_check_out?) %>
        <%= button_to "Hoàn tác", step == "check_in" ? pms_stay_undo_check_in_path(@undo) : pms_stay_undo_check_out_path(@undo),
              class: "min-h-11 px-3 font-semibold text-[#ddb8ca] cursor-pointer" %>
      <% end %>
    </div>
  <% end %>
<% else %>
  <%= render "pms/no_place" %>
<% end %>

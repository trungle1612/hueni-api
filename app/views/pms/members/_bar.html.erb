<%# Nhân viên và nhật ký's top bar (#245, board Audit.dc.html): back to Thêm, tabs Nhân viên / Nhật ký. -%>
<%# locals: (tab:) -%>
<% content_for :bar do %>
  <header class="sticky top-0 z-10 bg-pms-surface border-b border-pms-border">
    <div class="flex items-center gap-1 min-h-14 pl-1 pr-3">
      <%= link_to pms_more_path, class: "flex-none flex items-center justify-center size-11 rounded-md", "aria-label": "Quay lại" do %>
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>
      <% end %>
      <div class="flex-1 min-w-0 flex flex-col">
        <h1 class="text-[17px] leading-tight font-semibold truncate">Nhân viên và nhật ký</h1>
        <span class="text-xs text-pms-text-2 truncate"><%= current_place ? "#{current_place.name} · chỉ chủ cơ sở xem được trang này" : "Chỉ chủ cơ sở xem được trang này" %></span>
      </div>
    </div>
    <nav class="flex px-2" aria-label="Mục">
      <% [ [ :staff, "Nhân viên", pms_members_path ], [ :log, "Nhật ký", pms_activity_path ] ].each do |key, name, path| %>
        <%= link_to name, path, "aria-current": ("page" if key == tab),
              class: "flex-none flex items-center min-h-11 px-2.5 border-b-2 no-underline #{key == tab ? "border-pms-primary font-semibold" : "border-transparent text-pms-text-2 font-medium"}" %>
      <% end %>
    </nav>
  </header>
<% end %>
